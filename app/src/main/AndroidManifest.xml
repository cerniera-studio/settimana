<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The week: read only. New events go to the calendar app, which writes them -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Nodo's knots for each day's margin (the family's permission, defined by Nodo) -->
    <uses-permission android:name="com.cerniera.nodo.permission.NEXT" />

    <queries>
        <package android:name="com.cerniera.nodo" />
        <!-- Fold Widgets' look (finish and corners), as Nodo, Dorso and Riserva read it -->
        <package android:name="com.fergusonconsultancy.foldwidgets" />
        <!-- Opening an event and adding one: whichever calendar app the phone has -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.App"
        android:resizeableActivity="true">

        <!-- Folding and turning are handled in place: the week lays itself out again -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The week on the home screen (25 Nov 2026) -->
        <receiver
            android:name=".WeekWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Fold Widgets says its look or the wallpaper changed -->
                <action android:name="com.cerniera.LOOK_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget" />
        </receiver>

        <!-- Redraws the widget when the calendar or Nodo's knots change -->
        <service
            android:name=".Watch"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
