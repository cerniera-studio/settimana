<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The week: read only. New events go to the calendar app, which writes them -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Nodo's knots for each day's margin (the family's permission, defined by Nodo) -->
    <uses-permission android:name="com.cerniera.nodo.permission.NEXT" />

    <queries>
        <package android:name="com.cerniera.nodo" />
        <!-- Opening an event and adding one: whichever calendar app the phone has -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.App"
        android:resizeableActivity="true">

        <!-- Folding and turning are handled in place: the week lays itself out again -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
