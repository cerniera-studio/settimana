<?xml version="1.0" encoding="utf-8"?>
<!-- The widget is one picture drawn by Settimana at the widget's own size, with a tap area over each day -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_name" />
    <FrameLayout android:id="@+id/d0" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/d1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/d2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/d3" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/d4" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/d5" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/d6" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</FrameLayout>
